<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.userauth.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.knowledge.base.userauth.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="avatar" property="avatar"/>
        <result column="real_name" property="realName"/>
        <result column="department" property="department"/>
        <result column="position" property="position"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="email_verified" property="emailVerified"/>
        <result column="activation_token" property="activationToken"/>
        <result column="activation_token_expiry" property="activationTokenExpiry"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip" property="lastLoginIp"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>
    <sql id="Base_Column_List">id, username, password, email, phone, avatar, real_name, department, position, remark, status, email_verified, activation_token, activation_token_expiry, last_login_time, last_login_ip, create_time, update_time, create_by, update_by, deleted</sql>
    <select id="selectByUsername" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM kb_user WHERE username = #{username} AND deleted = 0 LIMIT 1</select>
    <select id="selectByEmail" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM kb_user WHERE email = #{email} AND deleted = 0 LIMIT 1</select>
    <select id="selectByPhone" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM kb_user WHERE phone = #{phone} AND deleted = 0 LIMIT 1</select>
    <select id="selectByActivationToken" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM kb_user WHERE activation_token = #{activationToken} AND deleted = 0 LIMIT 1</select>
    <select id="countDocumentsByAuthorId" resultType="java.lang.Long">SELECT COUNT(*) FROM kb_document WHERE author_id = #{authorId} AND deleted = 0</select>
    <select id="sumLikesByAuthorId" resultType="java.lang.Long">SELECT COALESCE(SUM(like_count), 0) FROM kb_document WHERE author_id = #{authorId} AND deleted = 0</select>
    <select id="sumViewsByAuthorId" resultType="java.lang.Long">SELECT COALESCE(SUM(view_count), 0) FROM kb_document WHERE author_id = #{authorId} AND deleted = 0</select>
</mapper>
